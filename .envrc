# Use AWS IAM Identity Center authentication for this project.
# The digitalcorpora profile signs into Simson's account through SSO.
# The digitalcorpora-storage-lens profile assumes the corpus read-only role.
# The project-local config stores profile settings, never credential values.
# Clear inherited IAM keys and tokens so AWS uses the selected SSO profile.
# OP_BYPASS_AWS makes the user's shell wrapper call AWS without 1Password.
# Authenticate with make aws-sso-login when the cached SSO session expires.
# Direnv restores the prior environment when leaving this directory.
watch_file etc/aws-digitalcorpora-config
unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_SECURITY_TOKEN AWS_DEFAULT_PROFILE
export AWS_PROFILE=digitalcorpora AWS_CONFIG_FILE="$PWD/etc/aws-digitalcorpora-config"
export AWS_REGION=us-west-2 AWS_DEFAULT_REGION=us-west-2
export OP_BYPASS_AWS=1
